# GlowIDE — placeholders only. Never put real secrets here.
# Frontend must NOT use VITE_ secrets. All keys live in Cloudflare Worker secrets.
# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# D1 / R2 / KV are bound in wrangler.toml, not env vars.
# OpenRouter (Worker secret only — set via: wrangler secret put OPENROUTER_API_KEY)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
# RPC providers (Worker secrets only)
ARC_RPC_URL=
BASE_RPC_URL=
ETHEREUM_RPC_URL=
SOLANA_RPC_URL=
# Circle (Worker secrets only, when configured)
CIRCLE_API_KEY=
# Email / SMS (Worker secrets only)
EMAIL_API_KEY=
SMS_API_KEY=
